<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0B1013">
  <meta name="description" content="Thoughtful print production, reviewed around your artwork, material and intended use.">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <% if (!path.startsWith('/admin')) { %>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Hadi Digital Craft home">
        <span class="brand-mark">H</span>
        <span>HADI DIGITAL CRAFT<small>PRINT · FINISH · FORM</small></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav">Menu</button>
      <nav id="main-nav">
        <a href="/services">Services</a>
        <a href="/finishing">Finishing</a>
        <a href="/surface-lab">Surface Lab</a>
        <a href="/#process">How we work</a>
        <a class="button button-small" href="/quote">Start a project <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
  <% } %>

  <% if (notice) { %>
    <div class="notice" role="status"><%= notice %></div>
  <% } %>
  <% if (error) { %>
    <div class="notice notice-error" role="alert"><%= error %></div>
  <% } %>

  <main id="main-content">
